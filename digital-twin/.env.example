# App configuration
APP_NAME=digital-twin
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# PostgreSQL configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digital_twin

# LLM Providers API Keys (optional for bootstrap, required for LangGraph LLM nodes)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Configuration (required for inactivity email escalation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SENDER_EMAIL=your_email@gmail.com

# Testing Configuration (required for MockLearnerData / end-to-end workflow tests)
TEST_RECIPIENT_EMAIL=your_test_inbox@example.com
